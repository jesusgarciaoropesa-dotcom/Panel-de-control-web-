# Configuración del backend (Supabase — proyecto wtj-barbershop).
#
# Copia este archivo a `.env` para que el frontend consuma el backend real:
#   cp .env.example .env && npm run dev
#
# Sin estas variables, la app usa datos simulados (mockProvider) — útil para
# desarrollo sin backend.
#
# La clave `anon` es PÚBLICA por diseño (pensada para el navegador). La
# seguridad la da RLS: el schema `panel` está cerrado a service_role, así que
# esta clave no da acceso a los tokens ni a las tablas del panel.

VITE_SUPABASE_URL=https://gimoqpusrdltlkrwsykr.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdpbW9xcHVzcmRsdGxrcndzeWtyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI0MDA0NDIsImV4cCI6MjA5Nzk3NjQ0Mn0.xmxP3TGAkXNPsrIKSYj1A-NXrIN1JIyzl9Fv6_FP8Dw

